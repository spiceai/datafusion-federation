---
source: datafusion-federation/src/sql/mod.rs
expression: "explain_query(&ctx,\n\"SELECT s_name \\\n                 FROM supplier \\\n                 JOIN lineitem ON s_suppkey = l_suppkey \\\n                 JOIN orders ON o_orderkey = l_orderkey \\\n                 WHERE NOT EXISTS ( \\\n                     SELECT 1 FROM lineitem AS l2 \\\n                     WHERE l2.l_orderkey = lineitem.l_orderkey \\\n                     AND l2.l_suppkey <> lineitem.l_suppkey \\\n                 )\",).await"
