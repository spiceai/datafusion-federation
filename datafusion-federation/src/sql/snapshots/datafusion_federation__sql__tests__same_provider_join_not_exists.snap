|               |     Inner Join:  Filter: supplier.s_suppkey = lineitem.l_suppkey                                                                                                                                                                                                                                                                                                                                  |
|               |       Filter: NOT EXISTS (<subquery>)                                                                                                                                                                                                                                                                                                                                                             |
|               |         Subquery:                                                                                                                                                                                                                                                                                                                                                                                 |
|               |           Projection: Int64(1)                                                                                                                                                                                                                                                                                                                                                                    |
|               |             SubqueryAlias: l2                                                                                                                                                                                                                                                                                                                                                                     |
|               |               Filter: lineitem.l_orderkey = outer_ref(lineitem.l_orderkey) AND lineitem.l_suppkey != outer_ref(lineitem.l_suppkey)                                                                                                                                                                                                                                                                |
